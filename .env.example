# ==============================================================================
# SUPABASE / POSTGIS DATABASE CONFIGURATION
# ==============================================================================
# Direct Connection (Use for running init.sql or large batch ingestion)
DIRECT_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Transaction Pooler (Use for FastAPI Backend async queries to prevent connection exhaustion)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Supabase API Credentials (Optional: if frontend connects directly to Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ==============================================================================
# MAP & API CONFIGURATION
# ==============================================================================
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoieW91ci11c2VybmFtZSIsImEiOiJ5b3VyLXRva2VuIn0
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000